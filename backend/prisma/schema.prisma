generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FacilityType {
  HOSPITAL
  CLINIC
  PHARMACY
}

enum FacilityStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum MedicineStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  FULFILLED
  CANCELLED
}

model Facility {
  id                 String              @id @default(uuid())
  name               String
  type               FacilityType
  address            String
  phone              String?
  email              String?
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  status             FacilityStatus      @default(PENDING_VERIFICATION)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  pharmacyProfile    PharmacyProfile?
  inventory          PharmacyInventory[]
  reservations       Reservation[]
  encounters         Encounter[]
}

enum EncounterStatus {
  WAITING
  IN_CONSULTATION
  ESCALATED
  COMPLETED
  CANCELLED
}

enum UrgencyLevel {
  RED
  YELLOW
  GREEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Patient {
  id                    String      @id @default(uuid())
  patientIdentifier     String      @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime?
  age                   Int?
  gender                Gender
  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  encounters            Encounter[]
}

model Encounter {
  id                  String             @id @default(uuid())
  patientId           String
  facilityId          String
  status              EncounterStatus    @default(WAITING)
  priority            UrgencyLevel?
  priorityScore       Int                @default(0)
  presentingComplaint String
  startedAt           DateTime           @default(now())
  endedAt             DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility            Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  triageAssessments   TriageAssessment[]
  queueEvents         QueueEvent[]

  @@index([facilityId, status])
}

model TriageAssessment {
  id                 String             @id @default(uuid())
  encounterId        String
  assessedBy         String?
  temperature        Float
  systolicBp         Int
  diastolicBp        Int
  pulseRate          Int
  respiratoryRate    Int
  oxygenSaturation   Float?
  redFlags           Json?
  symptoms           Json?
  recommendedUrgency UrgencyLevel
  reasoning          Json?
  finalUrgency       UrgencyLevel
  isCriticalAlert    Boolean            @default(false)
  assessedAt         DateTime           @default(now())
  encounter          Encounter          @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  overrides          ClinicalOverride[]
}

model ClinicalOverride {
  id                 String           @id @default(uuid())
  triageAssessmentId String
  overriddenBy       String
  previousUrgency    UrgencyLevel
  newUrgency         UrgencyLevel
  overrideReason     String
  overriddenAt       DateTime         @default(now())
  triageAssessment   TriageAssessment @relation(fields: [triageAssessmentId], references: [id], onDelete: Cascade)
}

model QueueEvent {
  id          String    @id @default(uuid())
  encounterId String
  eventType   String
  details     Json?
  timestamp   DateTime  @default(now())
  encounter   Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
}

model PharmacyProfile {
  id                 String   @id @default(uuid())
  facilityId         String   @unique
  licenceNumber      String?
  operatingHours     String?
  reservationEnabled Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  facility           Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model Medicine {
  id           String              @id @default(uuid())
  genericName  String
  brandName    String?
  strength     String
  dosageForm   String
  packageSize  String?
  manufacturer String?
  status       MedicineStatus      @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  inventory    PharmacyInventory[]
  Reservation  Reservation[]
}

model PharmacyInventory {
  id            String          @id @default(uuid())
  facilityId    String
  medicineId    String
  quantity      Int             @default(0)
  status        InventoryStatus @default(OUT_OF_STOCK)
  price         Decimal?
  lastUpdatedAt DateTime        @default(now())
  updatedBy     String?
  facility      Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicine      Medicine        @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([facilityId, medicineId])
}

model Reservation {
  id                 String            @id @default(uuid())
  prescriptionId     String
  prescriptionItemId String
  facilityId         String
  medicineId         String
  patientId          String
  status             ReservationStatus @default(PENDING)
  requestedAt        DateTime          @default(now())
  expiresAt          DateTime?
  updatedAt          DateTime          @updatedAt
  facility           Facility          @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicine           Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}
